@model HospitalAdminPanel.Models.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
}

<div class="login-page">
    <div class="login-page-bg" aria-hidden="true">
        <div class="login-page-bg-photo"></div>
        <div class="login-page-bg-waves"></div>
    </div>

    <div class="login-split-card login-animate">
        <div class="login-split-visual">
            <div class="login-visual-overlay" aria-hidden="true"></div>
            <div class="login-visual-copy">
                <h2 class="login-visual-headline">Hospital operations,<br />beautifully managed.</h2>
                <p class="login-visual-sub">
                    <i class="bi bi-heart-pulse"></i>
                    Better systems. Healthier tomorrows.
                </p>
            </div>
        </div>

        <div class="login-split-form">
            <div class="login-form-inner">
                <div class="login-form-brand">
                    <div class="login-form-logo-wrap">
                        <img src="~/images/hospital-logo.png" asp-append-version="true" alt="Bahria Town International Hospital Karachi" class="login-form-logo" />
                    </div>
                    <div class="login-form-brand-line" aria-hidden="true"></div>
                </div>
                <p class="login-welcome">WELCOME BACK</p>
                <h1>Login to your account</h1>
                <p class="login-form-lead">
                    Manage appointments, patient messaging, refills, and hospital analytics from one secure admin portal.
                </p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-glass alert-danger-soft">@Model.ErrorMessage</div>
                }
                @if (ViewData["ShowDevHints"] as bool? == true)
                {
                    <div class="login-dev-api">
                        <div class="login-dev-api-icon"><i class="bi bi-code-slash"></i></div>
                        <div class="login-dev-api-body">
                            <strong>Dev API</strong>
                            <span>@ViewData["ApiBaseUrl"] — admin / Admin@BTIH2026!</span>
                        </div>
                    </div>
                }

                <form asp-action="Login" method="post" class="login-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="login-field">
                        <label asp-for="Username">Username <span class="login-required">*</span></label>
                        <div class="login-input-wrap">
                            <i class="bi bi-person login-input-icon"></i>
                            <input asp-for="Username" class="login-input" autocomplete="username" placeholder="Enter your username" />
                        </div>
                    </div>

                    <div class="login-field">
                        <label asp-for="Password">Password <span class="login-required">*</span></label>
                        <div class="login-input-wrap">
                            <i class="bi bi-lock login-input-icon"></i>
                            <input asp-for="Password" type="password" class="login-input" id="loginPassword" autocomplete="current-password" placeholder="Enter your password" />
                            <button type="button" class="login-password-toggle" id="togglePassword" aria-label="Show password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>
                    </div>

                    <div class="login-form-row">
                        <label class="login-remember">
                            <input type="checkbox" id="rememberMe" name="rememberMe" />
                            <span>Remember me</span>
                        </label>
                        <a href="#" class="login-forgot" onclick="return false;">Forgot password?</a>
                    </div>

                    <button type="submit" class="login-submit-btn">
                        <span class="login-submit-icon"><i class="bi bi-box-arrow-in-right"></i></span>
                        <span>Sign In</span>
                    </button>
                </form>

                <p class="login-form-footer">
                    <i class="bi bi-shield-check"></i>
                    Secure &bull; Reliable &bull; Trusted
                    <span class="login-form-footer-sep">|</span>
                    <span class="login-form-footer-accent">BTH Admin Portal</span>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var btn = document.getElementById('togglePassword');
    var input = document.getElementById('loginPassword');
    if (!btn || !input) return;
    btn.addEventListener('click', function () {
        var isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        btn.querySelector('i').className = isPassword ? 'bi bi-eye' : 'bi bi-eye-slash';
        btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
    });
})();
</script>
}
