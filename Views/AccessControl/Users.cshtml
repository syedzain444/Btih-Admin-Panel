@model HospitalAdminPanel.Models.ViewModels.AccessUsersViewModel
@{
    ViewData["Title"] = "Admin Users";
    ViewData["HeroTitle"] = "Admin Users";
    ViewData["HeroSubtitle"] = "Create staff accounts and assign roles";
    ViewData["HeroIcon"] = "bi-person-gear";
    ViewData["HeroBreadcrumb"] = "Home / Access Control / Users";
}

@section HeroActions {
    <a asp-action="Roles" class="btn btn-outline-secondary me-2"><i class="bi bi-shield-lock"></i> Roles &amp; permissions</a>
    <a asp-action="CreateUser" class="btn btn-btih"><i class="bi bi-plus-lg"></i> Add user</a>
}

<div class="panel-card datatable-panel">
    <div class="table-responsive">
        <table class="table table-btih datatable-btih mb-0 w-100">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Display name</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Permissions</th>
                    <th class="no-sort">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td><strong>@u.Username</strong><div class="small text-muted">#@u.AdminId</div></td>
                    <td>@(u.DisplayName ?? "—")</td>
                    <td><span class="badge text-bg-light border">@u.Role</span></td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="badge-status badge-open">Active</span>
                        }
                        else
                        {
                            <span class="badge-status">Inactive</span>
                        }
                    </td>
                    <td class="small">@(u.Permissions?.Count ?? 0) modules</td>
                    <td>
                        <a asp-action="EditUser" asp-route-id="@u.AdminId" class="btn btn-sm btn-action btn-action-manage">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
