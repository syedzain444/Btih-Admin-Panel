@model HospitalAdminPanel.Models.ViewModels.TicketListViewModel
@{
    ViewData["Title"] = "Complaints & Support";
    ViewData["HeroTitle"] = "Complaints & Suggestions";
    ViewData["HeroSubtitle"] = "Patient complaints and suggestions from the mobile app — respond and update status";
    ViewData["HeroIcon"] = "bi-chat-left-quote";
    ViewData["HeroBreadcrumb"] = "Home / Support";
    var openCount = Model.Tickets.Count;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (openCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-bell-fill"></i>
        <div>
            <strong>@openCount</strong> open @(openCount == 1 ? "ticket needs" : "tickets need") attention.
            New mobile submissions appear here immediately for staff review.
        </div>
    </div>
}

<div class="panel-card datatable-panel">
    <div class="table-responsive">
        <table class="table table-btih datatable-btih mb-0 w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Contact</th>
                    <th>MR</th>
                    <th>Subject</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="no-sort">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model.Tickets)
            {
                <tr>
                    <td>@t.TicketId</td>
                    <td>
                        <div>@t.ContactName</div>
                        @if (!string.IsNullOrWhiteSpace(t.ContactPhone))
                        {
                            <div class="small text-muted">@t.ContactPhone</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(t.ContactEmail))
                        {
                            <div class="small text-muted">@t.ContactEmail</div>
                        }
                    </td>
                    <td>@(t.MrNo ?? "Guest")</td>
                    <td>
                        <strong>@t.Subject</strong>
                        <div class="small text-muted">@(t.Description.Length > 100 ? t.Description[..100] + "..." : t.Description)</div>
                    </td>
                    <td><span class="badge-status badge-category">@t.Category</span></td>
                    <td>
                        @{
                            var statusClass = t.Status.Contains("PROGRESS", StringComparison.OrdinalIgnoreCase)
                                ? "badge-pending"
                                : "badge-open";
                        }
                        <span class="badge-status @statusClass">@t.Status</span>
                    </td>
                    <td>@t.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        <button class="btn btn-sm btn-action btn-action-manage" data-bs-toggle="modal" data-bs-target="#ticketModal-@t.TicketId">
                            <i class="bi bi-sliders"></i> Manage
                        </button>
                        <div class="modal fade" id="ticketModal-@t.TicketId" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content" style="border-radius:16px;">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Ticket #@t.TicketId — @t.Category</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="Update" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-body">
                                            <input type="hidden" name="ticketId" value="@t.TicketId" />
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Patient message</label>
                                                <div class="p-3 rounded border bg-light" style="white-space:pre-wrap;">@t.Description</div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Status</label>
                                                <select name="status" class="form-select">
                                                    @if (t.Status == "OPEN")
                                                    {
                                                        <option value="OPEN" selected>Open</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="OPEN">Open</option>
                                                    }
                                                    @if (t.Status == "IN_PROGRESS")
                                                    {
                                                        <option value="IN_PROGRESS" selected>In Progress</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="IN_PROGRESS">In Progress</option>
                                                    }
                                                    @if (t.Status == "RESOLVED")
                                                    {
                                                        <option value="RESOLVED" selected>Resolved</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="RESOLVED">Resolved</option>
                                                    }
                                                    @if (t.Status == "CLOSED")
                                                    {
                                                        <option value="CLOSED" selected>Closed</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="CLOSED">Closed</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Reply / admin notes</label>
                                                <textarea name="adminNotes" class="form-control" rows="4" placeholder="Visible to the patient in the app">@t.AdminNotes</textarea>
                                                <div class="form-text">Saving a reply notifies the patient on their mobile app.</div>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-btih">Save &amp; notify patient</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (openCount == 0)
        {
            <div class="p-4 text-muted text-center">No open complaints or suggestions right now.</div>
        }
    </div>
</div>
