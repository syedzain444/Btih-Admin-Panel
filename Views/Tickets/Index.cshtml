@model HospitalAdminPanel.Models.ViewModels.TicketListViewModel
@{
    ViewData["Title"] = "Support Tickets";
    ViewData["HeroTitle"] = "Support Tickets";
    ViewData["HeroSubtitle"] = "Track and resolve patient support requests";
    ViewData["HeroIcon"] = "bi-life-preserver";
    ViewData["HeroBreadcrumb"] = "Home / Support";
}

<div class="panel-card datatable-panel">
    <div class="table-responsive">
        <table class="table table-btih datatable-btih mb-0 w-100">
            <thead><tr><th>ID</th><th>Contact</th><th>MR</th><th>Subject</th><th>Category</th><th>Status</th><th>Created</th><th class="no-sort">Actions</th></tr></thead>
            <tbody>
            @foreach (var t in Model.Tickets)
            {
                <tr>
                    <td>@t.TicketId</td>
                    <td>@t.ContactName</td>
                    <td>@(t.MrNo ?? "Guest")</td>
                    <td><strong>@t.Subject</strong><div class="small text-muted">@(t.Description.Length > 80 ? t.Description[..80] + "..." : t.Description)</div></td>
                    <td>@t.Category</td>
                    <td><span class="badge-status badge-open">@t.Status</span></td>
                    <td>@t.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <button class="btn btn-sm btn-action btn-action-manage" data-bs-toggle="modal" data-bs-target="#ticketModal-@t.TicketId"><i class="bi bi-sliders"></i> Manage</button>
                        <div class="modal fade" id="ticketModal-@t.TicketId" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content" style="border-radius:16px;">
                                    <div class="modal-header"><h5 class="modal-title">Ticket #@t.TicketId</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <form asp-action="Update" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-body">
                                            <input type="hidden" name="ticketId" value="@t.TicketId" />
                                            <div class="mb-3"><label class="form-label">Status</label>
                                                <select name="status" class="form-select">
                                                    <option value="IN_PROGRESS">In Progress</option>
                                                    <option value="RESOLVED">Resolved</option>
                                                    <option value="CLOSED">Closed</option>
                                                </select>
                                            </div>
                                            <div class="mb-3"><label class="form-label">Admin notes</label><textarea name="adminNotes" class="form-control" rows="3">@t.AdminNotes</textarea></div>
                                        </div>
                                        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-btih">Save</button></div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
