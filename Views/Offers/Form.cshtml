@model HospitalAdminPanel.Models.ViewModels.OfferFormViewModel
@{
    var isEdit = Model.OfferId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Offer" : "Add Offer";
    ViewData["HeroTitle"] = isEdit ? "Edit Offer / Package" : "Add Offer / Package";
    ViewData["HeroSubtitle"] = "Shown in the mobile app under More → Offers & Packages. Image optional (JPG/PNG/WEBP up to 6 MB).";
    ViewData["HeroIcon"] = "bi-gift";
    ViewData["HeroBreadcrumb"] = "Home / Offers / Form";
    var existingSrc = string.IsNullOrWhiteSpace(Model.ExistingImageUrl)
        ? null
        : (Model.ExistingImageUrl!.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.ExistingImageUrl
            : $"{Model.ApiBaseUrl}{Model.ExistingImageUrl}");
}

<div class="panel-card" style="max-width:820px;">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" asp-route-id="@(Model.OfferId)">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input asp-for="Title" class="form-control" maxlength="160" required />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Subtitle (optional)</label>
            <input asp-for="Subtitle" class="form-control" maxlength="200" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Category</label>
                <select asp-for="Category" class="form-select">
                    <option value="Package">Package</option>
                    <option value="Offer">Offer</option>
                    <option value="Checkup">Checkup</option>
                    <option value="Campaign">Campaign</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Sort order</label>
                <input asp-for="SortOrder" type="number" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" asp-for="IsActive">Active</label>
                </div>
            </div>
        </div>
        <div class="row g-3 mt-1">
            <div class="col-md-3">
                <label class="form-label">Currency</label>
                <input asp-for="Currency" class="form-control" maxlength="10" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Original price</label>
                <input asp-for="OriginalPrice" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="col-md-5">
                <label class="form-label">Offer price</label>
                <input asp-for="OfferPrice" type="number" step="0.01" min="0" class="form-control" />
            </div>
        </div>
        <div class="mb-3 mt-3">
            <label class="form-label">Highlights</label>
            <textarea asp-for="Highlights" class="form-control" rows="3" maxlength="2000"
                      placeholder="One per line, or separate with |"></textarea>
            <div class="form-text">Each bullet shown on the phone. Use new lines or <code>|</code>.</div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">CTA label</label>
                <input asp-for="CtaLabel" class="form-control" maxlength="60" />
            </div>
            <div class="col-md-6">
                <label class="form-label">CTA phone</label>
                <input asp-for="CtaPhone" class="form-control" maxlength="30" placeholder="021111111111" />
            </div>
        </div>
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label">Start at (optional)</label>
                <input asp-for="StartAt" type="datetime-local" class="form-control"
                       value="@(Model.StartAt?.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>
            <div class="col-md-6">
                <label class="form-label">End at (optional)</label>
                <input asp-for="EndAt" type="datetime-local" class="form-control"
                       value="@(Model.EndAt?.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>
        </div>
        <div class="mb-3 mt-3">
            <label class="form-label">@(isEdit ? "Replace image (optional)" : "Image (optional)")</label>
            <input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
            @if (!string.IsNullOrWhiteSpace(existingSrc))
            {
                <div class="mt-3">
                    <img src="@existingSrc" alt="Current" style="max-height:220px;border-radius:12px;border:1px solid #eee;" />
                </div>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-btih">@(isEdit ? "Save changes" : "Create")</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
