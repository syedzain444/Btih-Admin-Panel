@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.Title;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - BTIH Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
</head>
<body class="error-body">
    <div class="error-page">
        <div class="error-card">
            <div class="error-icon-wrap">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <div class="error-code">@Model.StatusCode</div>
            <h1 class="error-title">@Model.Title</h1>
            <p class="error-message">@Model.Message</p>

            @if (Model.ShowTechnicalDetails && !string.IsNullOrWhiteSpace(Model.TechnicalDetails))
            {
                <div class="error-tech-box">
                    <div class="error-tech-label"><i class="bi bi-bug me-1"></i> Technical details</div>
                    <pre>@Model.TechnicalDetails</pre>
                </div>
            }

            <div class="error-actions">
                @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                {
                    <a href="@Model.ReturnUrl" class="error-btn error-btn-primary">
                        <i class="bi bi-house-door me-1"></i> @Model.ReturnLabel
                    </a>
                }
                <button type="button" class="error-btn error-btn-secondary" onclick="history.back()">
                    <i class="bi bi-arrow-left me-1"></i> Go back
                </button>
            </div>

            <div class="error-meta">
                @if (!string.IsNullOrWhiteSpace(Model.ErrorCode))
                {
                    <span><i class="bi bi-tag me-1"></i>@Model.ErrorCode</span>
                }
                @if (Model.ShowRequestId)
                {
                    <span><i class="bi bi-fingerprint me-1"></i>Ref: @Model.RequestId</span>
                }
            </div>
        </div>

        <div class="error-footer">
            <span class="error-brand">BTIH Admin Portal</span>
            <span class="error-footer-note">If this keeps happening, share the reference ID with your administrator.</span>
        </div>
    </div>
</body>
</html>
