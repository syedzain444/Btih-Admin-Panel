@inject HospitalAdminPanel.Services.ITokenSessionService TokenSession
@inject Microsoft.Extensions.Options.IOptions<HospitalAdminPanel.Configuration.AdminPanelSettings> PanelSettings
@{
    var user = TokenSession.GetUser();
    var role = user?.Role;
    var hospital = PanelSettings.Value.HospitalName;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var initials = user?.DisplayName?.Substring(0, 1) ?? user?.Username?.Substring(0, 1) ?? "A";
    bool Can(string module) => AdminModulePermissions.CanAccess(role, module, user?.Permissions);
    var isLoginPage = controller.Equals("Account", StringComparison.OrdinalIgnoreCase)
        && !action.Equals("Forbidden", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BTIH Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isLoginPage ? "login-body" : "app-body")@(controller.Equals("Messages", StringComparison.OrdinalIgnoreCase) ? " messages-module" : "")">
<div id="appSplash" class="app-splash" aria-live="polite" aria-busy="true">
    <div class="splash-inner">
        <img src="~/images/Hospital-Logo-w.png" asp-append-version="true" alt="Bahria Town International Hospital Karachi" class="splash-logo-img" />
        <div class="splash-title">BTIH Admin Portal</div>
        <div class="splash-subtitle">Bahria Town International Hospital</div>
        <div class="splash-progress"><div class="splash-progress-bar"></div></div>
    </div>
</div>
<div id="pageLoader" class="page-loader" aria-hidden="true" aria-live="polite">
    <div class="loader-card">
        <div class="loader-spinner"></div>
        <span class="loader-text">Loading...</span>
    </div>
</div>
<div id="navProgress" class="nav-progress" aria-hidden="true"></div>
@if (isLoginPage)
{
    @RenderBody()
}
else
{
    <div class="app-shell">
        <div class="app-bg-decoration" aria-hidden="true"></div>
        <aside class="icon-rail">
            <div class="rail-logo" title="BTIH Admin">
                <img src="~/images/hospital-logo.png" asp-append-version="true" alt="Bahria Town International Hospital Karachi" class="rail-logo-img" />
            </div>
            @if (Can(AdminModules.Dashboard))
            {
                <a class="rail-link @(controller=="Dashboard"?"active":"")" asp-controller="Dashboard" asp-action="Index" title="Dashboard"><i class="bi bi-house-door-fill"></i></a>
            }
            @if (Can(AdminModules.Messages))
            {
                <a class="rail-link @(controller=="Messages"?"active":"")" asp-controller="Messages" asp-action="Index" title="Messages"><i class="bi bi-chat-dots-fill"></i></a>
            }
            @if (Can(AdminModules.Appointments))
            {
                <a class="rail-link @(controller=="Appointments"?"active":"")" asp-controller="Appointments" asp-action="Index" title="Appointments"><i class="bi bi-calendar3-event-fill"></i></a>
            }
            @if (Can(AdminModules.Users))
            {
                <a class="rail-link @(controller=="Users"?"active":"")" asp-controller="Users" asp-action="Index" title="Users"><i class="bi bi-people-fill"></i></a>
            }
            @if (Can(AdminModules.Reports))
            {
                <a class="rail-link @(controller=="Reports"?"active":"")" asp-controller="Reports" asp-action="Index" title="Reports"><i class="bi bi-bar-chart-fill"></i></a>
            }
            <div class="rail-spacer"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="header-icon-btn border-0" title="Logout"><i class="bi bi-box-arrow-right"></i></button>
            </form>
        </aside>

        <aside class="nav-panel" id="navPanel">
            <div class="workspace-switcher">
                <span>@hospital</span>
                <i class="bi bi-chevron-expand text-muted"></i>
            </div>

            <div class="nav-section-label">Starred</div>
            <div class="nav-tree">
                @if (Can(AdminModules.Dashboard))
                {
                    <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-star-fill nav-star"></i> Overview</a>
                }
                @if (Can(AdminModules.Messages))
                {
                    <a asp-controller="Messages" asp-action="Index"><i class="bi bi-star-fill nav-star"></i> Inbox</a>
                }
            </div>

            @if (Can(AdminModules.Refills) || Can(AdminModules.Tickets))
            {
                <div class="nav-section-label">Recent</div>
                <div class="nav-tree">
                    @if (Can(AdminModules.Refills))
                    {
                        <a asp-controller="Refills" asp-action="Index">Refill queue</a>
                    }
                    @if (Can(AdminModules.Tickets))
                    {
                        <a asp-controller="Tickets" asp-action="Index">
                            Support tickets
                            @{
                                var recentTicketCount = (ViewData["TicketCount"] as int?) ?? 0;
                            }
                            @if (recentTicketCount > 0)
                            {
                                <span class="nav-badge">@recentTicketCount</span>
                            }
                        </a>
                    }
                </div>
            }

            <div class="nav-section-label">Hospital modules</div>
            <div class="nav-tree">
                <div class="nav-tree-item fw-semibold text-dark"><i class="bi bi-grid"></i> Dashboard</div>
                <div class="nav-nested">
                    @if (Can(AdminModules.Dashboard))
                    {
                        <a class="@(controller=="Dashboard" && action=="Index" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Overview</a>
                    }
                    @if (Can(AdminModules.Messages))
                    {
                        <a class="@(controller=="Messages"?"active":"")" asp-controller="Messages" asp-action="Index">
                            Messages <span class="nav-badge">@((ViewData["MsgCount"] as int?) ?? 0)</span>
                        </a>
                    }
                    @if (Can(AdminModules.Appointments))
                    {
                        <a class="@(controller=="Appointments"?"active":"")" asp-controller="Appointments" asp-action="Index">Appointments</a>
                    }
                    @if (Can(AdminModules.Users))
                    {
                        <a class="@(controller=="Users"?"active":"")" asp-controller="Users" asp-action="Index">Patients</a>
                    }
                </div>
                @if (Can(AdminModules.Refills) || Can(AdminModules.Tickets) || Can(AdminModules.Promotions) || Can(AdminModules.Offers) || Can(AdminModules.SupportContent) || Can(AdminModules.Reports))
                {
                    <div class="nav-tree-item fw-semibold text-dark mt-2"><i class="bi bi-clipboard-data"></i> Operations</div>
                    <div class="nav-nested">
                        @if (Can(AdminModules.Refills))
                        {
                            <a class="@(controller=="Refills"?"active":"")" asp-controller="Refills" asp-action="Index">
                                Refills <span class="nav-dot"></span>
                            </a>
                        }
                        @if (Can(AdminModules.Tickets))
                        {
                            <a class="@(controller=="Tickets"?"active":"")" asp-controller="Tickets" asp-action="Index">
                                Support
                                @{
                                    var ticketCount = (ViewData["TicketCount"] as int?) ?? 0;
                                }
                                @if (ticketCount > 0)
                                {
                                    <span class="nav-badge">@ticketCount</span>
                                }
                            </a>
                        }
                        @if (Can(AdminModules.Promotions))
                        {
                            <a class="@(controller=="Promotions"?"active":"")" asp-controller="Promotions" asp-action="Index">Promotions</a>
                        }
                        @if (Can(AdminModules.Offers))
                        {
                            <a class="@(controller=="Offers"?"active":"")" asp-controller="Offers" asp-action="Index">Offers &amp; Packages</a>
                        }
                        @if (Can(AdminModules.SupportContent))
                        {
                            <a class="@(controller=="SupportContent"?"active":"")" asp-controller="SupportContent" asp-action="Index">Help Content</a>
                        }
                        @if (Can(AdminModules.Reports))
                        {
                            <a class="@(controller=="Reports"?"active":"")" asp-controller="Reports" asp-action="Index">Reports &amp; audit</a>
                        }
                    </div>
                }
            </div>

            <div class="nav-section-label mt-3">System</div>
            <div class="nav-tree">
                @if (Can(AdminModules.AccessControl))
                {
                    <a class="@(controller=="AccessControl"?"active":"")" asp-controller="AccessControl" asp-action="Users">
                        <i class="bi bi-shield-lock"></i> Access control
                    </a>
                }
                <a href="#"><i class="bi bi-link-45deg"></i> API health</a>
            </div>
        </aside>

        <div class="main-wrap">
            <header class="top-header">
                <button type="button" class="header-icon-btn sidebar-toggle" id="sidebarToggle"><i class="bi bi-list"></i></button>
                <div class="search-pill">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="Try searching 'patients', 'appointments'..." disabled />
                </div>
                <div class="header-actions">
                    @if (!string.IsNullOrWhiteSpace(role))
                    {
                        <span class="badge rounded-pill text-bg-light border me-1" title="Signed-in role">@role</span>
                    }
                    <button type="button" class="header-icon-btn"><i class="bi bi-sliders"></i></button>
                    @if (Can(AdminModules.Messages))
                    {
                        <a asp-controller="Messages" asp-action="Index" class="header-icon-btn text-decoration-none"><i class="bi bi-bell"></i></a>
                    }
                    <div class="header-avatar" title="@(user?.DisplayName ?? user?.Username)">@initials</div>
                </div>
            </header>
            <main class="content-area">
                @if (TempData["Success"] != null) { <input type="hidden" id="tempSuccess" value="@TempData["Success"]" /> }
                @if (TempData["Error"] != null) { <input type="hidden" id="tempError" value="@TempData["Error"]" /> }
                <div class="page-transition-wrap" id="pageContent">
                    @if (ViewData["HeroTitle"] != null)
                    {
                        <section class="page-hero">
                            <div class="page-hero-inner">
                                <div class="page-hero-left">
                                    <div class="page-hero-icon">
                                        <i class="bi @(ViewData["HeroIcon"] ?? "bi-grid")"></i>
                                    </div>
                                    <div class="page-hero-text">
                                        @if (ViewData["HeroBreadcrumb"] != null)
                                        {
                                            <nav class="page-hero-breadcrumb">@Html.Raw(ViewData["HeroBreadcrumb"])</nav>
                                        }
                                        <h1 class="page-hero-title">@ViewData["HeroTitle"]</h1>
                                        @if (ViewData["HeroSubtitle"] != null)
                                        {
                                            <p class="page-hero-subtitle">@ViewData["HeroSubtitle"]</p>
                                        }
                                    </div>
                                </div>
                                <div class="page-hero-actions">
                                    @await RenderSectionAsync("HeroActions", required: false)
                                </div>
                            </div>
                        </section>
                    }
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/admin.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
